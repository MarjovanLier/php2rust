{
    "description": "A small Laravel app written by hand for php2rust to convert end to end (ADR 0012).",
    "type": "project",
    "license": "MIT",
    "require": {
        "laravel/framework": "13.44.1",
        "spatie/laravel-data": "4.23.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    }
}
